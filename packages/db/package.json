    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@budgetkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24"
  }
}
