{
  "name": "@budgetkit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./migrations/*.sql": "./src/migrations/*.sql"
