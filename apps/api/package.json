{
  "name": "@budgetkit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:export": "tsx src/db/scripts/db-export.ts",
    "db:import": "tsx src/db/scripts/db-import.ts"
  },
  "dependencies": {
    "@budgetkit/core": "workspace:*",
    "@budgetkit/db": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.10"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=24"
  }
}
